# Runtime
SESSION_SECRET=
COOKIE_SECURE=true
DATA_DRIVER=sheets
DATA_DIR=/tmp/tw7-scout-platform-data

# Durable production data (server-side only)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Official deployment: leave both false
DEMO_LOGIN=false
SEED_DEMO=false

# Optional AI card generation (server-side only; feature is off by default)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Preview compatibility only. Keep false in Production: session tokens must not enter URLs.
ALLOW_URL_SESSION=false
